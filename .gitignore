*.aux
*.vrb
*.fdb_latexmk
*.fls
*.nav
*.snm
*.synctex.gz
examples/**/*.log
examples/**/*.out
examples/**/*.toc
examples/**/build.log

# Built videos (hosted on GitHub Releases)
examples/**/*.mp4

# Legacy MARP-era caches (only ElevenLabs mp3s are tracked)
