# Build artifacts
dist/
*.egg-info/

# The compiled frontend (built from frontend/ by `make frontend`, shipped in wheels)
src/slidesonnet/server/static/
src/slidesonnet/server/static.next/
src/slidesonnet/server/static.old/
frontend/node_modules/

# API keys and secrets
.env

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage

# Claude Code local settings
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Editor / IDE
.vscode/

# OS
.DS_Store

# Deck cache (page renders, audio clips, previews)
**/.slidesonnet/

# slidesonnet.sty is generated next to a deck via `slidesonnet sty`
examples/**/slidesonnet.sty

# LaTeX build artifacts
examples/**/.build/
*.aux
*.vrb
*.fdb_latexmk
*.fls
*.nav
*.snm
*.synctex.gz
examples/**/*.log
examples/**/*.out
examples/**/*.toc
examples/**/build.log

# Built videos (hosted on GitHub Releases)
examples/**/*.mp4

# setuptools build dir
build/
.claude/worktrees/
