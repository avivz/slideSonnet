% slidesonnet.sty — LaTeX package for slideSonnet narration directives
%
% Defines \say, \nonarration, and \slidesonnetskip as no-ops so that Beamer
% presentations compile normally with pdflatex/latexmk. The slideSonnet tool
% parses these commands directly from the .tex source.
%
% Usage in preamble:
%   \usepackage{slidesonnet}
%
% Usage in frames:
%   \say<2>{Narration spoken on overlay step 2.}
%   \say<2>[voice=alice, pace=slow]{Step 2 with a voice override.}
%   \say[2]{Legacy form — bare number in brackets, same as <2>.}
%   \nonarration        % intentionally no narration
%   \nonarration[3]     % ... held silent for 3 seconds
%   \slidesonnetskip    % omit frame from video
%
% The overlay step in <...> mirrors beamer's own overlay specs (\onslide<2>,
% \item<2->): it selects which built-up page of the frame the narration plays
% on. A bare \say{...} (no step) is rejected by the parser — always number it.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{slidesonnet}[2026/06/09 slideSonnet narration directives]

% \say<overlay>[options]{text} — narration directive (ignored by LaTeX).
% d<> : optional beamer-style overlay spec delimited by < >
% o   : optional [voice=..., pace=...] / bare-number options
% m   : mandatory narration text
\NewDocumentCommand{\say}{d<> o m}{}

% \nonarration[duration] — marks slide as intentionally silent (optional seconds)
\NewDocumentCommand{\nonarration}{o}{}

% \slidesonnetskip — omit frame from video entirely
% Note: \skip is a TeX primitive (length register) and is NOT redefined here.
\newcommand{\slidesonnetskip}{}
