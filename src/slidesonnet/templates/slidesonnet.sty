% slidesonnet.sty — LaTeX package for slideSonnet slide-id markers
%
% Stamps a stable, invisible slide-id onto every emitted PDF page (including
% each overlay step) so the slideSonnet narration editor can key narration to
% slides by id rather than by brittle page numbers.
%
% Usage in preamble:
%   \usepackage{slidesonnet}
%
% Usage in frames:
%   \begin{frame}
%     \ssid<1>{euler-setup}     % id for overlay step 1
%     \ssid<2>{euler-trick}     % id for overlay step 2
%     \ssid<3>{euler-result}    % ranges work too: \ssid<2-3>{...}
%     ...
%   \end{frame}
%
%   \begin{frame}
%     \ssid{intro-title}        % non-overlay frame: one id for its single page
%     ...
%   \end{frame}
%
% Any emitted page with no matching \ssid is stamped a positional default
% "auto-p<page>-s<sub>"; the slideSonnet reader warns so it gets a real name.
%
% The marker is rendered with PDF text rendering mode 3 (invisible — the same
% mechanism OCR text layers use): it never shows on screen or in print, on any
% background, yet is reliably recovered from the text layer.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{slidesonnet}[2026/06/09 slideSonnet slide-id markers]

\RequirePackage{tikz}

\makeatletter

% \ssid<step>{id}  -> set id on the matching overlay step(s)
% \ssid{id}        -> set id for a non-overlay frame's single page
\newcommand{\ssid}{\@ifnextchar<\ssid@spec\ssid@bare}
\def\ssid@spec<#1>#2{\only<#1>{\ssid@set{#2}}}
\def\ssid@bare#1{\ssid@set{#1}}

% Store the id keyed by ABSOLUTE page number -> no cross-page stale state.
\def\ssid@set#1{\expandafter\gdef\csname ssid@page@\the\c@page\endcsname{#1}}

% Invisible-but-extractable marker text (PDF text rendering mode 3).
\def\ssid@marker#1{%
  \begin{tikzpicture}[remember picture,overlay]
    \node[anchor=south west,inner sep=0pt,font=\tiny] at (current page.south west)
      {\pdfliteral{3 Tr}SSID:#1\pdfliteral{0 Tr}};
  \end{tikzpicture}%
}

% Fires once per emitted PAGE, so every overlay step is covered.
\addtobeamertemplate{background}{}{%
  \@ifundefined{ssid@page@\the\c@page}%
    {\ssid@marker{auto-p\the\c@page-s\the\beamer@slideinframe}}%
    {\ssid@marker{\csname ssid@page@\the\c@page\endcsname}}%
}

\makeatother
